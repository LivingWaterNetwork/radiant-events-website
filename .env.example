# Inquiry form delivery (Resend — https://resend.com)
# Without RESEND_API_KEY and INQUIRY_NOTIFICATION_EMAIL the form shows
# "Inquiries are temporarily unavailable" and never fakes a success.

# Resend API key (Vercel: Settings → Environment Variables, Preview + Production).
RESEND_API_KEY=

# Where inquiries are delivered. Comma-separate for several addresses.
INQUIRY_NOTIFICATION_EMAIL=

# Sender. Must be on a domain verified in Resend. If unset, Resend's shared
# test sender (onboarding@resend.dev) is used, which only delivers to the
# Resend account owner's own address.
INQUIRY_FROM_EMAIL="Radiant Events Planning <inquiries@example-verified-domain>"

# Optional: set to "production" only on the production deployment. Anything
# else (Vercel sets VERCEL_ENV automatically) serves noindex headers and a
# disallow-all robots.txt.
# VERCEL_ENV=
